        <mxCell id="legend_reading" value="Read each line from both ends: the marker next to an entity says how many of that entity relate to one instance at the other end, e.g. Project ||——o&lt; Dataset: each Dataset belongs to exactly one Project; a Project has zero or many Datasets." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="116" y="1160" width="868" height="56" as="geometry" />
        </mxCell>
        <mxCell id="legend_group_platform" value="" style="rounded=0;html=1;fillColor=#dbeafe;strokeColor=#111827;strokeWidth=1.2;" vertex="1" parent="1">
          <mxGeometry x="124" y="1224" width="90" height="24" as="geometry" />
        </mxCell>
        <mxCell id="legend_group_platform_text" value="Entity managed by Platform BE" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#111827;" vertex="1" parent="1">
          <mxGeometry x="228" y="1223" width="750" height="26" as="geometry" />
        </mxCell>
        <mxCell id="scope_note" value="Scope: Conceptual level: the business entities Platform BE manages, their named relationships and crow's-foot cardinality; no attributes, keys or storage detail. Read each relationship name from the entity at the 'one' (or 'zero or one') end toward the other entity. Project is the top-level scope: BRD/PRD define no organization above it. A Run is carried out by Popper; the scientific content Popper produces inside a run is in the overall Conceptual ERD, not here. Every entity also records the user who created it; only the user links that carry a business rule are drawn." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontFamily=Helvetica;fontSize=10;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="40" y="1310" width="1320" height="50" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
